# ==============================================================================
# Clash of Clans Studio Workstation - Authoritative .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (STRICT EXCLUSION)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.local
*.secret
*.secrets
*.token
token.txt
credentials.json
client_secret*.json
client-secret*.json
service-account*.json
service_account*.json

# Keystores & Android signing
*.keystore
*.jks

# Shell history & netrc credential stores
.netrc
.bash_history
.zsh_history
.history

# Private keys & certificates
*.key
*.pem
*.pfx
*.p12
*.pkcs12
*.cer
*.crt
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub

# ------------------------------------------------------------------------------
# 2. Node.js & Vite Toolchain Build Artifacts (studio/ and root)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
dist/
*/dist/
build/
*/build/
.vite/
*/.vite/
coverage/
*/coverage/
*.tsbuildinfo
.eslintcache
.stylelintcache
.npm/
.yarn/

# ------------------------------------------------------------------------------
# 3. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
tmp/
temp/

# ------------------------------------------------------------------------------
# 4. OS & System Metadata Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 5. IDEs & Editor Configuration
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 6. Teamwork & AI Agent Metadata (Internal orchestration)
# ------------------------------------------------------------------------------
.agents/
**/.agents/
tests/harness/
tests/runner.mjs
TEST_INFRA.md

# ------------------------------------------------------------------------------
# 7. Asset Whitelist Protection (Clash of Clans Assets & Core Files)
# Negate ignore rules for valid media assets, metadata, scripts, and docs
# ------------------------------------------------------------------------------
!*.webp
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.ico
!*.gitkeep
!*.bat
!*.md
!assets-metadata.json
