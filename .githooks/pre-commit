#!/bin/sh
# ==============================================================================
# .githooks/pre-commit
# Clash of Clans Image Repository - Pre-Commit Security Hook
# Cross-platform POSIX script for Git on Windows, Linux, and macOS
# ==============================================================================

set -e

# Terminal ANSI color escape codes (suppressed if non-interactive)
if [ -t 1 ]; then
  RED='\033[1;31m'
  YELLOW='\033[1;33m'
  GREEN='\033[1;32m'
  CYAN='\033[1;36m'
  BOLD='\033[1m'
  NC='\033[0m'
else
  RED=''
  YELLOW=''
  GREEN=''
  CYAN=''
  BOLD=''
  NC=''
fi

FAILED=0

# ------------------------------------------------------------------------------
# 1. Native Inspection: Staged Filenames
# ------------------------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -n "$STAGED_FILES" ]; then
  # Exclude verified repository tooling and internal metadata
  FILTERED_FILES=$(echo "$STAGED_FILES" | grep -v -E '^(scripts/verify-secrets\.mjs|\.githooks/)' || true)

  if [ -n "$FILTERED_FILES" ]; then
    FORBIDDEN_FILE_REGEX='(\.env($|\.)|\.pem$|\.key$|\.pkcs12$|\.p12$|\.pfx$|(^|/)id_(rsa|dsa|ecdsa|ed25519)|credentials\.json|client[-_]secret.*\.json|service[-_]account.*\.json|\.(keystore|jks)$|\.netrc$|\.(bash_history|zsh_history)$|\.token$|\.secret$|(^|/)token\.txt$)'
    BLOCKED_FILES=$(echo "$FILTERED_FILES" | grep -E -i "$FORBIDDEN_FILE_REGEX" || true)

    if [ -n "$BLOCKED_FILES" ]; then
      FAILED=1
      printf "\n${RED}================================================================================\n" >&2
      printf "${BOLD}[SECURITY ALERT] Sensitive File(s) Detected in Staging Area!\n" >&2
      printf "================================================================================${NC}\n" >&2
      printf "${YELLOW}The following staged file(s) match prohibited credential/key patterns:${NC}\n\n" >&2
      echo "$BLOCKED_FILES" | while IFS= read -r f; do
        printf "  ${RED}✖ %s${NC}\n" "$f" >&2
      done
      printf "\n${CYAN}Remediation Steps:${NC}\n" >&2
      printf "  1. Unstage the prohibited file(s):\n" >&2
      printf "     ${BOLD}git reset HEAD <file>${NC}\n" >&2
      printf "  2. Ensure sensitive files are listed in ${BOLD}.gitignore${NC}\n" >&2
      printf "  3. If sensitive credentials exist inside, remove or rotate them immediately.\n" >&2
      printf "${RED}================================================================================${NC}\n\n" >&2
    fi
  fi
fi

# ------------------------------------------------------------------------------
# 2. Native Inspection: Staged Added Lines for Secret Tokens
# ------------------------------------------------------------------------------
ADDED_LINES=$(git diff --cached -U0 -- . ":(exclude)tests/harness" 2>/dev/null | grep -E '^\+[^+]' || true)

if [ -n "$ADDED_LINES" ]; then
  # Structured high-entropy token patterns
  SECRET_REGEX='github_pat_[a-zA-Z0-9_]{50,120}|ghp_[a-zA-Z0-9]{36}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA|OPENSSH|EC|DSA|PGP)? ?PRIVATE KEY-----'
  MATCHED_SECRETS=$(echo "$ADDED_LINES" | grep -E -e "$SECRET_REGEX" || true)

  if [ -n "$MATCHED_SECRETS" ]; then
    FAILED=1
    printf "\n${RED}================================================================================\n" >&2
    printf "${BOLD}[SECURITY ALERT] High-Entropy Secret / Token Detected in Staged Diff!\n" >&2
    printf "================================================================================${NC}\n" >&2
    printf "${YELLOW}Staged diff contains added lines matching high-entropy secret patterns:${NC}\n\n" >&2

    if echo "$MATCHED_SECRETS" | grep -E -q -e 'github_pat_[a-zA-Z0-9_]{50,120}'; then
      printf "  ${RED}✖ GitHub Fine-Grained Personal Access Token (github_pat_*)${NC}\n" >&2
    fi
    if echo "$MATCHED_SECRETS" | grep -E -q -e 'ghp_[a-zA-Z0-9]{36}'; then
      printf "  ${RED}✖ GitHub Classic Personal Access Token (ghp_*)${NC}\n" >&2
    fi
    if echo "$MATCHED_SECRETS" | grep -E -q -e 'AKIA[0-9A-Z]{16}'; then
      printf "  ${RED}✖ AWS Access Key ID (AKIA*)${NC}\n" >&2
    fi
    if echo "$MATCHED_SECRETS" | grep -E -q -e '-----BEGIN (RSA|OPENSSH|EC|DSA|PGP)? ?PRIVATE KEY-----'; then
      printf "  ${RED}✖ Cryptographic Private Key Header (-----BEGIN ... PRIVATE KEY-----)${NC}\n" >&2
    fi

    printf "\n${CYAN}Remediation Steps:${NC}\n" >&2
    printf "  1. Remove secret tokens from your staged files before committing.\n" >&2
    printf "  2. Move secrets into an uncommitted ${BOLD}.env${NC} file excluded by ${BOLD}.gitignore${NC}.\n" >&2
    printf "  3. If these credentials have ever been committed or shared, revoke them immediately.\n" >&2
    printf "${RED}================================================================================${NC}\n\n" >&2
  fi
fi

# ------------------------------------------------------------------------------
# 3. Secondary Deep Scan: Node.js Verification Engine (if available)
# ------------------------------------------------------------------------------
if [ "$FAILED" -eq 0 ] && command -v node >/dev/null 2>&1 && [ -f "scripts/verify-secrets.mjs" ]; then
  if ! node scripts/verify-secrets.mjs --staged; then
    FAILED=1
  fi
fi

# ------------------------------------------------------------------------------
# 4. Final Disposition
# ------------------------------------------------------------------------------
if [ "$FAILED" -ne 0 ]; then
  printf "${RED}${BOLD}[COMMIT ABORTED] Prohibited files or secrets detected. Commit rejected.${NC}\n\n" >&2
  exit 1
fi

exit 0
